# Postgres connection string (Neon in development; any Postgres in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public address of this site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Only "production" may be indexed by search engines; anything else is noindex
SITE_ENV=development

# Background jobs: "true" on an always-on server; on serverless, call /api/payload-jobs/run
# from the host's scheduler with "Authorization: Bearer $CRON_SECRET"
JOBS_AUTORUN=true
CRON_SECRET=

# Photo storage (any S3-compatible bucket). Leave S3_BUCKET empty to store on local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Order emails (any SMTP service). Leave SMTP_HOST empty to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=orders@blingitonjewels.com
EMAIL_FROM_NAME=Blingiton

# Claude API, for the automatic SEO text, translations and alt text
ANTHROPIC_API_KEY=
